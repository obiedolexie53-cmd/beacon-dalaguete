# Copy to .env and adjust. Never commit real secrets.

# PostgreSQL (docker-compose uses these)
POSTGRES_USER=beacon
POSTGRES_PASSWORD=beacon_dev_password
POSTGRES_DB=beacon
POSTGRES_PORT=5432

# API (read by backend/app/core/config.py, prefix BEACON_)
BEACON_ENVIRONMENT=development
BEACON_DATABASE_URL=postgresql+psycopg://beacon:beacon_dev_password@localhost:5432/beacon
BEACON_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]
BEACON_MEDIA_ROOT=./media
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
BEACON_SECRET_KEY=change-me-dev-only-never-use-in-production
