{
  "name": "beacon-dalaguete",
  "private": true,
  "type": "module",
  "description": "BEACON: community-based disaster reporting and monitoring for the Municipality of Dalaguete, Cebu (research prototype)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:resident": "pnpm --filter @beacon/resident dev",
    "dev:mdrrmo": "pnpm --filter @beacon/mdrrmo dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "pnpm build && pnpm --filter @beacon/e2e test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
